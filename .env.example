NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# ==============================================================================
# SYSTÈME D'IA MULTI-PALIERS PHAR (AVEC CASCADE & SECOURS AUTOMATIQUE)
# ==============================================================================

# PALIER 1 : MISTRAL AI (https://console.mistral.ai)
MISTRAL_API_KEY=
# MISTRAL_MODEL=mistral-small-latest

# PALIER 2 : GOOGLE GEMINI (Plan Gratuit : https://aistudio.google.com)
# Se déclenche automatiquement si Mistral ne fonctionne pas ou dépasse ses quotas gratuits.
GEMINI_API_KEY=
# Modèles gratuits recommandés : gemini-2.0-flash (par défaut) ou gemini-1.5-flash
# GEMINI_MODEL=gemini-2.0-flash

# PALIER 3 : MODÈLES OPEN-SOURCE (HuggingFace / OpenRouter / Groq / Ollama local)
# Se déclenche automatiquement si Gemini ne fonctionne pas.
# OPENSOURCE_API_KEY=
# OPENSOURCE_API_URL=https://api-inference.huggingface.co/v1
# OPENSOURCE_MODEL=meta-llama/Llama-3.2-3B-Instruct

# PALIER 4 : MOTEUR LOCAL DÉTERMINISTE
# Si aucune clé externe n'est disponible ou en cas de coupure réseau,
# le moteur heuristique local intégré prend le relais sans aucune coupure.
